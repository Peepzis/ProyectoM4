# Firebase (cliente)
# Copiar este archivo como .env y completar con los datos del proyecto de Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Servidor (función api/send-summary.ts)
# Solo las usa la función de Vercel. Sin prefijo VITE_ a propósito: nunca deben llegar al navegador.
# Se cargan en Vercel (Settings > Environment Variables o con "vercel env add"), no se suben a GitHub.
# Para probar en local con "vercel dev": "vercel env pull .env.local" y luego "source" del archivo.

# Cuenta de servicio de Firebase (el JSON completo, codificado en base64, en una sola línea)
FIREBASE_SERVICE_ACCOUNT_B64=

# Credenciales del usuario IAM de AWS con permiso solo para enviar emails (ses:SendEmail)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Región de AWS donde está configurado SES (la de esta cuenta es us-east-2)
AWS_REGION=

# Email remitente verificado en SES
SES_FROM_EMAIL=